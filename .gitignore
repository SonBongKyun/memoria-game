# Godot 4.x
.godot/

# Export/build outputs
build/
*.exe
*.pck

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
*.swp
*.swo

# fablize goal-tracking state (session tooling)
.fablize/

# Local visual-audit captures
/tmp/

# Unreal migration: generated outputs only; existing Godot asset policy is unchanged.
/Unreal/**/Binaries/
/Unreal/**/DerivedDataCache/
/Unreal/**/Intermediate/
/Unreal/**/Saved/
# Validation evidence (captures, logs, raw zips) is local-only; git history
# kept multi-gigabyte runs unpushable. Reports summarize results in docs.
/docs/unreal-migration/evidence/
/Unreal/**/.vs/
/Unreal/**/*.sln
/Unreal/**/*.slnx
/Unreal/**/*.vcxproj*
/Unreal/**/*.VC.db
/Unreal/**/*.VC.opendb
/Unreal/**/*.suo
/Unreal/**/*.user
/Unreal/**/__pycache__/

# Phase 1D raw engine logs are preserved byte-for-byte in full_logs.zip.
/docs/unreal-migration/evidence/phase1d/**/*.log
# Phase 1E full logs are likewise retained without newline changes in the archive.
/docs/unreal-migration/evidence/phase1e/**/*.log

# Phase 1F raw logs are preserved byte-for-byte in full_logs.zip.
/docs/unreal-migration/evidence/phase1f/**/*.log

# Phase 1G full logs are archived byte-for-byte.
docs/unreal-migration/evidence/phase1g/**/*.log

docs/unreal-migration/evidence/phase1h/**/*.log

# Phase 1I raw logs are preserved byte-for-byte in full_logs.zip.
docs/unreal-migration/evidence/phase1i/**/*.log

# Phase 1J raw logs are preserved byte-for-byte in full_logs.zip.
docs/unreal-migration/evidence/phase1j/**/*.log

docs/unreal-migration/evidence/phase1k/**/*.log
docs/unreal-migration/evidence/phase1l/**/*.log

docs/unreal-migration/evidence/phase1m/**/*.log

docs/unreal-migration/evidence/phase1n/**/*.log

# Raw Phase 1O logs are retained byte-for-byte in evidence archives.
docs/unreal-migration/evidence/phase1o/**/*.log

# UE 5.8 template mannequin, copied from the engine by Unreal/Tools/install_mannequin.py (S310 stand-in)
/Unreal/Memoria/Content/Characters/Mannequins/
# Third-party animation sources imported by -run=MemoriaSwordRetarget (S312); only the retargeted clips are committed
/Unreal/Memoria/Content/Memoria/Imported/
