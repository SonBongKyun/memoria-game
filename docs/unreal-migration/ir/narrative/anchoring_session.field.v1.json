{"content_kind":"narrative.field","definition":{"id":"anchoring_session","index_mapping_version":1,"metadata":{"chapter":4,"title":"Drift","title_ko":"표류"},"rows":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/0","jump":null,"original_index":0,"presentation":{"cg":"res://assets/cg/generated/chapter_expansion/ch04_anchor_tea_thread_v1.png"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":0,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"speaker":"","text":"Arrel placed his palms on hers. Elia's fingers were cold. Her ability always pulled warmth inward.","text_ko":"아렐은 그녀의 손바닥 위에 손을 얹었다. 엘리아의 손가락은 차가웠다. 그녀의 능력은 언제나 온기를 안으로 끌어당겼다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/1","jump":null,"original_index":1,"presentation":{"portrait":"elia_neutral"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":1,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"speaker":"Elia","text":"Close your eyes.","text_ko":"눈 감아."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/2","jump":null,"original_index":2,"presentation":{},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":2,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"speaker":"","text":"Her thumbs pressed hard into his palms. The constant hum of deterioration went quiet, as if someone had put a hand on a cracked wall and said: not yet.","text_ko":"그녀의 엄지손가락이 그의 손바닥을 세게 눌렀다. 끊임없던 붕괴의 웅웅거림이 잦아들었다. 누군가 금 간 벽에 손을 대고 '아직은 안 돼'라고 말한 것처럼."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/3","jump":null,"original_index":3,"presentation":{"portrait":"elia_concern"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":3,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":3,"text":{"speaker":"Elia","text":"Stay with me. What's your name?","text_ko":"여기 있어. 네 이름은?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/4","jump":null,"original_index":4,"presentation":{"portrait":"arrel_pain"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":4,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":4,"text":{"speaker":"Arrel","text":"Arrel.","text_ko":"아렐."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/5","jump":null,"original_index":5,"presentation":{"portrait":"elia_concern"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":5,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":5,"text":{"speaker":"Elia","text":"Where are we?","text_ko":"여긴 어디지?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/6","jump":null,"original_index":6,"presentation":{"portrait":"arrel_neutral"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":6,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":6,"text":{"speaker":"Arrel","text":"The Belt's edge. East of the waystation. Heading south for the Rim.","text_ko":"벨트 가장자리. 역참 동쪽. 림을 향해 남쪽으로 가는 중."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/7","jump":null,"original_index":7,"presentation":{"portrait":"elia_concern"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":7,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":7,"text":{"speaker":"Elia","text":"What did you have for breakfast?","text_ko":"아침으로 뭘 먹었어?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/8","jump":null,"original_index":8,"presentation":{"portrait":"arrel_pain"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":8,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":8,"text":{"speaker":"Arrel","text":"I ate. I don't remember what.","text_ko":"먹기는 했어. 뭘 먹었는지는 기억 안 나."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/9","jump":null,"original_index":9,"presentation":{"portrait":"elia_concern"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":9,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":9,"text":{"speaker":"Elia","text":"The reading should return. I patched the bridge between symbol processing and language recall. The breakfast was adjacent. It tore away.","text_ko":"읽기는 돌아올 거야. 기호 처리와 언어 회상 사이의 다리를 덧댔어. 아침 기억은 바로 옆에 있었고, 찢겨 나갔어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/10","jump":null,"original_index":10,"presentation":{"portrait":"arrel_neutral"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":10,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":10,"text":{"speaker":"Arrel","text":"How long will the patch hold?","text_ko":"그 덧댄 건 얼마나 버티지?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/11","jump":null,"original_index":11,"presentation":{"portrait":"elia_concern"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":11,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":11,"text":{"speaker":"Elia","text":"Depends on how often you burn.","text_ko":"네가 얼마나 자주 태우느냐에 달렸어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/anchoring_session/12","jump":null,"original_index":12,"presentation":{"cg":"res://assets/cg/generated/archive_drift_anchoring_v1.png"},"provenance":{"dialect":"field","group_position":2,"original_choice_index":-1,"original_index":12,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":12,"text":{"speaker":"","text":"Arrel read the faded Authority warning on the fallen wall. The words assembled themselves. For now.","text_ko":"아렐은 무너진 벽의 빛바랜 관리국 경고문을 읽었다. 단어들이 서로 맞물렸다. 지금은."}}]},"dialect":"field","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"bdc23927af1e8ab500a68c4399042656e3fa11554ede227ba9ed4a4600ae4eee","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/chapter4_dialogue.json","sha256_utf8_lf":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
