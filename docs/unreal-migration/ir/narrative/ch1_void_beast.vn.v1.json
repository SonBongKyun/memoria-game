{"content_kind":"narrative.vn","definition":{"id":"ch1_void_beast","index_mapping_version":1,"metadata":{"chapter":1,"title":"Chapter 1, The Void Beast","title_ko":"1장, 보이드 비스트"},"steps":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/0","jump":null,"original_index":0,"presentation":{"cg":"res://assets/cg/generated/story_ch1_void_beast_emergence.png","fade_ms":600},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":0,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"narrate":"It uncoiled from the canopy like something the forest had been hiding from itself.","narrate_ko":"그것은 숲이 스스로에게서 숨겨왔던 것처럼 나뭇잎 사이에서 몸을 풀며 내려왔다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/1","jump":null,"original_index":1,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":1,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"narrate":"Too many limbs. Too few joints. A throat that opened the wrong way.","narrate_ko":"팔다리는 너무 많고, 관절은 너무 적었다. 목구멍은 잘못된 방향으로 벌어졌다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/2","jump":null,"original_index":2,"presentation":{"portrait":"elia_determined","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":2,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"speaker":"Elia","text":"It's hollow. There's no person left in it. You can hit it as hard as you need to.","text_ko":"속이 비었어. 저 안에는 더 이상 사람이 남아 있지 않아. 필요한 만큼 세게 쳐도 돼."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/3","jump":null,"original_index":3,"presentation":{"portrait":"arrel_determined","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":3,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":3,"text":{"speaker":"Arrel","text":"I know.","text_ko":"알아."}},{"action":{},"choices":[{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"set_flag":"vb_round1"},"gate":{},"id":"vn/ch1_void_beast/4/choice/0","jump":6,"original_index":0,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":0,"original_index":4,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Strike with the sword.","text_ko":"검으로 벤다."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"cost_memory":"sense_warm_light"},"gate":{},"id":"vn/ch1_void_beast/4/choice/1","jump":13,"original_index":1,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":1,"original_index":4,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Burn the warmth in your hand. Channel it through the blade.","text_ko":"손에 남은 온기를 태워 칼날에 흘려넣는다."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"set_flag":"vb_read"},"gate":{},"id":"vn/ch1_void_beast/4/choice/2","jump":20,"original_index":2,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":2,"original_index":4,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Wait. Read its rhythm.","text_ko":"기다린다. 놈의 리듬을 읽는다."}}],"choices_present":true,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/4","jump":null,"original_index":4,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":4,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":4,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/5","jump":null,"original_index":5,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":5,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":5,"text":{"narrate":"[ Filler, choice always jumps. ]","narrate_ko":"[ 더미, 선택지는 항상 건너뜁니다. ]"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/6","jump":null,"original_index":6,"presentation":{"cg":"res://assets/cg/generated/story_ch1_void_beast_emergence.png","fade_ms":400},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":6,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":6,"text":{"narrate":"He stepped in. The blade went where it always went, clean, efficient, taught long ago by hands he could no longer name.","narrate_ko":"그는 파고들었다. 칼날은 늘 가던 곳으로 갔다. 깔끔하고, 효율적이고, 이제는 이름도 떠올릴 수 없는 손들이 오래전에 가르쳐준 궤적이었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/7","jump":null,"original_index":7,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":7,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":7,"text":{"narrate":"The thing screamed without using its mouth.","narrate_ko":"그것은 입을 쓰지 않고 비명을 질렀다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/8","jump":null,"original_index":8,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":8,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":8,"text":{"narrate":"A grey limb whipped down where his head had been a moment before. He felt the pressure of it as much as he saw it.","narrate_ko":"회색 팔다리 하나가 방금 전 그의 머리가 있던 자리를 후려쳤다. 그는 그것을 보는 만큼이나 압력으로 느꼈다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/9","jump":null,"original_index":9,"presentation":{"portrait":"elia_concern","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":9,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":9,"text":{"speaker":"Elia","text":"It's faster than the last one!","text_ko":"지난번 놈보다 빨라!"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/10","jump":null,"original_index":10,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":10,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":10,"text":{"narrate":"First wound: shallow. Survival, not victory.","narrate_ko":"첫 상처는 얕았다. 승리가 아니라 생존이었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/11","jump":null,"original_index":11,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":11,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":11,"text":{"narrate":"But it was bleeding now, if grey smoke pouring out of a wound counted as bleeding.","narrate_ko":"그래도 이제 피를 흘리고 있었다. 상처에서 회색 연기가 쏟아지는 것을 피라고 부를 수 있다면."}},{"action":{"action":"goto_scene","id":"ch1_void_beast","start_index":28},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/12","jump":null,"original_index":12,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":12,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":12,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/13","jump":null,"original_index":13,"presentation":{"cg":"res://assets/cg/generated/illustration_expansion_v2/world_rewrite_first_sword_v3.png","fade_ms":500},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":13,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":13,"text":{"narrate":"Warm light through a window. A room he could not place. He held it in his hand and let it go.","narrate_ko":"창문 너머의 따뜻한 빛. 어디였는지 알 수 없는 방. 그는 그것을 손에 쥐고 놓아주었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/14","jump":null,"original_index":14,"presentation":{"cg":"res://assets/cg/generated/story_ch1_first_burn_strike.png","fade_ms":350},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":14,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":14,"text":{"narrate":"The blade caught fire, not heat, but the *idea* of heat, golden and impossible.","narrate_ko":"칼날에 불이 붙었다. 열이 아니라, 열이라는 생각 그 자체였다. 황금빛이고, 있을 수 없는 불."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/15","jump":null,"original_index":15,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":15,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":15,"text":{"narrate":"It cleaved through the beast's torso like through cloth.","narrate_ko":"칼날은 천을 가르듯 괴물의 몸통을 갈랐다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/16","jump":null,"original_index":16,"presentation":{"portrait":"elia_hopeful","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":16,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":16,"text":{"speaker":"Elia","text":"...That was something.","text_ko":"...방금 건 대단했어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/17","jump":null,"original_index":17,"presentation":{"portrait":"arrel_exhausted","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":17,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":17,"text":{"speaker":"Arrel","text":"It was warmth I'll never feel again.","text_ko":"다시는 느끼지 못할 온기였어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/18","jump":null,"original_index":18,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":18,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":18,"text":{"narrate":"The beast staggered, half its weight gone in one strike.","narrate_ko":"괴물은 비틀거렸다. 한 번의 베기로 몸의 절반을 잃은 듯했다."}},{"action":{"action":"goto_scene","id":"ch1_void_beast","start_index":28},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/19","jump":null,"original_index":19,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":19,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":19,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/20","jump":null,"original_index":20,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":20,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":20,"text":{"narrate":"He held the blade low and let it come.","narrate_ko":"그는 칼날을 낮게 들고 놈이 오게 두었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/21","jump":null,"original_index":21,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":21,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":21,"text":{"narrate":"The thing moved in waves, limbs not striking but *flowing*, looking for a way through his guard.","narrate_ko":"그것은 파도처럼 움직였다. 팔다리는 치는 것이 아니라 흘러들었고, 그의 방어를 뚫을 길을 찾고 있었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/22","jump":null,"original_index":22,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":22,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":22,"text":{"narrate":"He saw the pattern. Three sweeps high, one low. A rhythm older than the creature, older than the forest.","narrate_ko":"그는 패턴을 보았다. 높게 세 번, 낮게 한 번. 괴물보다 오래되고, 숲보다도 오래된 리듬."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/23","jump":null,"original_index":23,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":23,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":23,"text":{"narrate":"When the low strike came, he stepped through it and put the sword between two of its ribs.","narrate_ko":"낮은 공격이 왔을 때, 그는 그 안으로 발을 들이고 놈의 갈비 사이에 검을 꽂았다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/24","jump":null,"original_index":24,"presentation":{"portrait":"elia_determined","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":24,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":24,"text":{"speaker":"Elia","text":"Clean.","text_ko":"깔끔했어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{"set_flag":"vb_read"},"gate":{},"id":"vn/ch1_void_beast/25","jump":null,"original_index":25,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":25,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":25,"text":{"narrate":"It was. The beast retreated, smoke leaking, cautious now.","narrate_ko":"정말 그랬다. 괴물은 연기를 흘리며 물러났고, 이제는 조심스러워졌다."}},{"action":{"action":"goto_scene","id":"ch1_void_beast","start_index":28},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/26","jump":null,"original_index":26,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":26,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":26,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/27","jump":null,"original_index":27,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":27,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":27,"text":{"narrate":"[ === Round 2 starts at index 23 === ]","narrate_ko":"[ === 2라운드 시작 지점 === ]"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/28","jump":null,"original_index":28,"presentation":{"cg":"res://assets/cg/generated/cinematic_void_beast_memory_devour.png","fade_ms":400},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":28,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":28,"text":{"narrate":"The beast did not die from one wound. It *learned* from it.","narrate_ko":"괴물은 상처 하나로 죽지 않았다. 그것은 그 상처에서 배웠다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/29","jump":null,"original_index":29,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":29,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":29,"text":{"narrate":"It widened. The hollow at its center opened, and from inside, more grey, older grey, the kind that smelled like other people's losses.","narrate_ko":"몸이 벌어졌다. 중심의 빈 구멍이 열리고, 안쪽에서 더 많은 회색이 흘러나왔다. 더 오래된 회색, 타인의 상실 냄새가 나는 회색이었다."}},{"action":{},"choices":[{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{},"gate":{},"id":"vn/ch1_void_beast/30/choice/0","jump":32,"original_index":0,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":0,"original_index":30,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Strike again. Faster this time.","text_ko":"다시 벤다. 이번엔 더 빠르게."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"cost_memory":"sense_forest_smell"},"gate":{},"id":"vn/ch1_void_beast/30/choice/1","jump":37,"original_index":1,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":1,"original_index":30,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Burn the smell of forest after rain. Make every cut count.","text_ko":"비 온 뒤 숲의 냄새를 태워 모든 베기를 치명타로 만든다."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{},"gate":{"requires_flag":"vb_read"},"id":"vn/ch1_void_beast/30/choice/2","jump":43,"original_index":2,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":2,"original_index":30,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Use what you read. Counter its rhythm.","text_ko":"읽어낸 것을 이용해 놈의 리듬을 역이용한다."}}],"choices_present":true,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/30","jump":null,"original_index":30,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":30,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":30,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/31","jump":null,"original_index":31,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":31,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":31,"text":{"narrate":"[ Filler. ]","narrate_ko":"[ 더미. ]"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/32","jump":null,"original_index":32,"presentation":{"cg":"res://assets/cg/generated/cinematic_void_beast_memory_devour.png","fade_ms":400},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":32,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":32,"text":{"narrate":"He moved faster than was wise. The beast's limb caught his shoulder, and pain bloomed bright and clean.","narrate_ko":"그는 지나치게 빠르게 움직였다. 괴물의 팔다리가 어깨를 스쳤고, 선명하고 깨끗한 통증이 피어났다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/33","jump":null,"original_index":33,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":33,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":33,"text":{"narrate":"But the blade was already through it. Through it. Through it.","narrate_ko":"하지만 칼날은 이미 놈을 관통하고 있었다. 한 번. 또 한 번. 또 한 번."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/34","jump":null,"original_index":34,"presentation":{"portrait":"arrel_burn","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":34,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":34,"text":{"speaker":"Arrel","text":"...How much does it have left?","text_ko":"...얼마나 남았지?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/35","jump":null,"original_index":35,"presentation":{"portrait":"elia_concern","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":35,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":35,"text":{"speaker":"Elia","text":"Less than you. Keep going.","text_ko":"너보다는 적어. 계속해."}},{"action":{"action":"goto_scene","id":"ch1_void_beast","start_index":50},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/36","jump":null,"original_index":36,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":36,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":36,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/37","jump":null,"original_index":37,"presentation":{"cg":"res://assets/cg/generated/illustration_expansion_v2/world_rewrite_reaching_hand_v3.png","fade_ms":500},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":37,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":37,"text":{"narrate":"The smell of wet earth after rainfall. Where, when, gone.","narrate_ko":"비가 그친 뒤 젖은 흙 냄새. 어디였는지, 언제였는지. 사라졌다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/38","jump":null,"original_index":38,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":38,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":38,"text":{"narrate":"Every strike found its mark. The beast could not turn away from him.","narrate_ko":"모든 공격이 제자리를 찾아갔다. 괴물은 그에게서 몸을 돌릴 수 없었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/39","jump":null,"original_index":39,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":39,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":39,"text":{"narrate":"Its grey opened, opened, until there was nothing left for it to be.","narrate_ko":"그 회색은 계속 벌어졌고, 마침내 그것으로 남을 것이 아무것도 없어졌다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/40","jump":null,"original_index":40,"presentation":{"portrait":"elia_sad","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":40,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":40,"text":{"speaker":"Elia","text":"...Arrel.","text_ko":"...아렐."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/41","jump":null,"original_index":41,"presentation":{"portrait":"arrel_exhausted","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":41,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":41,"text":{"speaker":"Arrel","text":"I know.","text_ko":"알아."}},{"action":{"action":"goto_scene","id":"ch1_void_beast","start_index":50},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/42","jump":null,"original_index":42,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":42,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":42,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/43","jump":null,"original_index":43,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":43,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":43,"text":{"narrate":"He moved as he had read the beast move, not against its rhythm, but *with* it.","narrate_ko":"그는 읽어낸 그대로 움직였다. 놈의 리듬에 맞서지 않고, 그 리듬과 함께."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/44","jump":null,"original_index":44,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":44,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":44,"text":{"narrate":"When its limb came high, he was already low. When the low strike opened, he was already past it.","narrate_ko":"놈의 팔다리가 높게 올 때 그는 이미 낮았다. 낮은 공격이 열릴 때 그는 이미 그 너머에 있었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/45","jump":null,"original_index":45,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":45,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":45,"text":{"narrate":"The killing cut went where the rhythm wanted it to go, and the beast had no answer.","narrate_ko":"마지막 베기는 리듬이 원하는 곳으로 흘러갔고, 괴물에게는 답이 없었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/46","jump":null,"original_index":46,"presentation":{"portrait":"elia_calm","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":46,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":46,"text":{"speaker":"Elia","text":"You learned its name.","text_ko":"놈의 이름을 배웠구나."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/47","jump":null,"original_index":47,"presentation":{"portrait":"arrel_pensive","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":47,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":47,"text":{"speaker":"Arrel","text":"It didn't have one to learn.","text_ko":"배울 이름 같은 건 없었어."}},{"action":{"action":"goto_scene","id":"ch1_void_beast","start_index":50},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/48","jump":null,"original_index":48,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":48,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":48,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/49","jump":null,"original_index":49,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":49,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":49,"text":{"narrate":"[ === Endgame at 47 === ]","narrate_ko":"[ === 종료 구간 === ]"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/50","jump":null,"original_index":50,"presentation":{"cg":"res://assets/cg/generated/story_ch1_opening_aftermath.png","fade_ms":1200},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":50,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":50,"text":{"narrate":"What remained of the beast collapsed into a stain of grey ash that the wind took, slowly, like the wind was trying to be respectful about it.","narrate_ko":"괴물의 잔해는 회색 재의 얼룩으로 무너졌다. 바람은 마치 예의를 갖추려는 듯 그것을 천천히 데려갔다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/51","jump":null,"original_index":51,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":51,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":51,"text":{"narrate":"He stood over it, breathing harder than he wanted Elia to see.","narrate_ko":"그는 그 앞에 서서 숨을 몰아쉬었다. 엘리아에게 보이고 싶은 것보다 훨씬 거칠게."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/52","jump":null,"original_index":52,"presentation":{"portrait":"elia_calm","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":52,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":52,"text":{"speaker":"Elia","text":"You're hurt.","text_ko":"다쳤어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/53","jump":null,"original_index":53,"presentation":{"portrait":"arrel_exhausted","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":53,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":53,"text":{"speaker":"Arrel","text":"I'll keep.","text_ko":"버틸 수 있어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/54","jump":null,"original_index":54,"presentation":{"portrait":"elia_concern","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":54,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":54,"text":{"speaker":"Elia","text":"You're hurt. And you burned for it.","text_ko":"다쳤잖아. 게다가 그 대가로 태웠고."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/55","jump":null,"original_index":55,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":55,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":55,"text":{"narrate":"He didn't answer.","narrate_ko":"그는 대답하지 않았다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/56","jump":null,"original_index":56,"presentation":{"portrait":"elia_sad","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":56,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":56,"text":{"speaker":"Elia","text":"I just want to know what was worth it.","text_ko":"뭐가 그만한 가치가 있었는지 알고 싶을 뿐이야."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/57","jump":null,"original_index":57,"presentation":{"portrait":"arrel_cold","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":57,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":57,"text":{"speaker":"Arrel","text":"Standing here. With you. Worth it.","text_ko":"여기 서 있는 것. 너와 말하고 있는 것. 그만한 가치가 있었어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{"set_flag":"ch1_void_beast_defeated"},"gate":{},"id":"vn/ch1_void_beast/58","jump":null,"original_index":58,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":58,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":58,"text":{"narrate":"She looked at him a long moment. Then she turned, and they walked on.","narrate_ko":"그녀는 한참 동안 그를 바라보았다. 그리고 몸을 돌렸고, 둘은 다시 걸었다."}},{"action":{"action":"goto_scene","id":"ch1_after_forest"},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_void_beast/59","jump":null,"original_index":59,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":59,"source_file":"data/vn_scenes/ch1_void_beast.json","source_hash":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":59,"text":{}}]},"dialect":"vn","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"34dbdf867180c578b7da48be4d2adaa82eca08dfadb7219eacf7bc474922d90d","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/vn_scenes/ch1_void_beast.json","sha256_utf8_lf":"70c3a1794dc17aeecfbae20d7f9d02f6bfb83d2e49f96a1dbcd17e4156bb2b20"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
