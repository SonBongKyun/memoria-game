{"content_kind":"narrative.vn","definition":{"id":"ch1_after_forest","index_mapping_version":1,"metadata":{"chapter":1,"title":"Chapter 1, After the Forest","title_ko":"1장, 숲 이후"},"steps":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/0","jump":null,"original_index":0,"presentation":{"cg":"res://assets/cg/generated/story_ch1_twisted_forest_path.png","fade_ms":1500},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":0,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"narrate":"The forest thinned. The air cleared, or rather, it replaced one kind of thickness with another.","narrate_ko":"숲이 얇아졌습니다. 공기가 맑아졌습니다. 오히려 한 종류의 두께를 다른 두께로 대체했습니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/1","jump":null,"original_index":1,"presentation":{"portrait":"elia_concern","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":1,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"speaker":"Elia","text":"You fought through that without burning anything else.","text_ko":"당신은 다른 것을 태우지 않고 그것을 극복했습니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/2","jump":null,"original_index":2,"presentation":{"portrait":"arrel_exhausted","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":2,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"speaker":"Arrel","text":"I know.","text_ko":"알아요."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/3","jump":null,"original_index":3,"presentation":{"portrait":"elia_concern","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":3,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":3,"text":{"speaker":"Elia","text":"You're keeping count.","text_ko":"당신은 카운트를 유지하고 있습니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/4","jump":null,"original_index":4,"presentation":{"portrait":"arrel_cold","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":4,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":4,"text":{"speaker":"Arrel","text":"I always keep count.","text_ko":"나는 항상 숫자를 세어본다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/5","jump":null,"original_index":5,"presentation":{"cg":"ch1_green_tree","fade_ms":1800},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":5,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":5,"text":{"narrate":"A single tree, still green, stood at the edge of the clearing like a joke the world had forgotten to finish.","narrate_ko":"세상이 끝내는 것을 잊어버린 농담처럼 공터 가장자리에 아직 녹색인 나무 한 그루가 서 있었습니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/6","jump":null,"original_index":6,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":6,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":6,"text":{"narrate":"Elia stopped. Her hand went to the bark, fingers spread against the living wood as if checking whether it would answer.","narrate_ko":"엘리아는 멈춰섰다. 그녀의 손은 나무껍질로 향했고, 마치 그것이 응답할지 확인하려는 듯 손가락을 살아있는 나무에 대고 펼쳤습니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/7","jump":null,"original_index":7,"presentation":{"portrait":"elia_hopeful","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":7,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":7,"text":{"speaker":"Elia","text":"It's still warm.","text_ko":"아직 따뜻해요."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/8","jump":null,"original_index":8,"presentation":{"portrait":"arrel_pensive","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":8,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":8,"text":{"speaker":"Arrel","text":"It won't be, by winter.","text_ko":"겨울까지는 그렇지 않을 것입니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/9","jump":null,"original_index":9,"presentation":{"portrait":"elia_sad","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":9,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":9,"text":{"speaker":"Elia","text":"No. It won't.","text_ko":"아니요. 그렇지 않습니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/10","jump":null,"original_index":10,"presentation":{"cg":"res://assets/cg/game_image/sealed_city_ruins.png","fade_ms":2000},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":10,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":10,"text":{"narrate":"Beyond the treeline, far to the south, the Bureau's tower scraped at the clouds like a finger pointing out an accusation.","narrate_ko":"수목한계 너머, 멀리 남쪽에는 국의 탑이 비난을 가리키는 손가락처럼 구름을 긁어냈다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/11","jump":null,"original_index":11,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":11,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":11,"text":{"narrate":"That was where the answers were. That was where he would have to go.","narrate_ko":"거기에 답이 있었습니다. 그가 가야 할 곳은 바로 그곳이었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_after_forest/12","jump":null,"original_index":12,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":12,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":12,"text":{"narrate":"But first, the Belt. And the man who might know whether his brother was still alive.","narrate_ko":"하지만 먼저, 벨트. 그리고 형이 아직 살아 있는지 알 수도 있는 남자."}},{"action":{"action":"goto_scene","id":"ch2_market_arrival"},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{"autosave_chapter_transition":true,"complete_chapter":1,"set_chapter":2,"set_flag":"ch1_complete"},"gate":{},"id":"vn/ch1_after_forest/13","jump":null,"original_index":13,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":13,"source_file":"data/vn_scenes/ch1_after_forest.json","source_hash":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":13,"text":{}}]},"dialect":"vn","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"b01e04fce853669d6f241b85ec60f0d7059bdc2d7f5ffef5c8c76ad9f7625381","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/vn_scenes/ch1_after_forest.json","sha256_utf8_lf":"92297a1a6c45870316e2d28aaf506137131609d6e8c2309fdb67dca38c32794f"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
