{"content_kind":"narrative.field","definition":{"id":"elia_ch2_talk","index_mapping_version":1,"metadata":{"chapter":2,"title":"The Price","title_ko":"가격"},"rows":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/elia_ch2_talk/0","jump":null,"original_index":0,"presentation":{"cg":"res://assets/cg/generated/chapter_splash_verdan_market.png","portrait":"elia_neutral"},"provenance":{"dialect":"field","group_position":5,"original_choice_index":-1,"original_index":0,"source_file":"data/chapter2_dialogue.json","source_hash":"67ec5b7c5f455f41ba997fd6c84220f85f8f87f7f111ef9b3e28c8ead935ac21","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"burned_text":"There was this market you mentioned once... You don't remember it at all, do you?","burned_text_ko":"예전에 말씀하셨던 시장이 있었는데... 전혀 기억나지 않으시죠?","requires_memory":"daily_market_food","speaker":"Elia","text":"Don't linger. People remember faces here, even if they can't remember why.","text_ko":"오래 서 있지 마. 여기 사람들은 얼굴을 기억해. 왜인지는 기억 못 해도."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/elia_ch2_talk/1","jump":null,"original_index":1,"presentation":{"portrait":"arrel_neutral"},"provenance":{"dialect":"field","group_position":5,"original_choice_index":-1,"original_index":1,"source_file":"data/chapter2_dialogue.json","source_hash":"67ec5b7c5f455f41ba997fd6c84220f85f8f87f7f111ef9b3e28c8ead935ac21","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"speaker":"Arrel","text":"Ironic.","text_ko":"아이러니하군."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/elia_ch2_talk/2","jump":null,"original_index":2,"presentation":{"portrait":"elia_concern"},"provenance":{"dialect":"field","group_position":5,"original_choice_index":-1,"original_index":2,"source_file":"data/chapter2_dialogue.json","source_hash":"67ec5b7c5f455f41ba997fd6c84220f85f8f87f7f111ef9b3e28c8ead935ac21","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"burned_text":"You said someone used to sing by the campfire. But you can't even recall the melody now.","burned_text_ko":"당신은 어떤 사람이 모닥불 옆에서 노래를 부르곤 했다고 하더군요. 하지만 지금은 그 멜로디조차 기억나지 않습니다.","requires_memory":"daily_campfire_song","speaker":"Elia","text":"Not the kind of irony that's funny.","text_ko":"웃긴 종류의 아이러니는 아니야."}}]},"dialect":"field","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"ea4aada8b7398aa27d4c7505ff3fb6282cf25690f8cd298fe7f78337b1c41a21","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/chapter2_dialogue.json","sha256_utf8_lf":"67ec5b7c5f455f41ba997fd6c84220f85f8f87f7f111ef9b3e28c8ead935ac21"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
