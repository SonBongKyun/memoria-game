{"content_kind":"narrative.field","definition":{"id":"class_seven_wall_message","index_mapping_version":1,"metadata":{"chapter":3,"title":"Weight of Pages","title_ko":"페이지의 무게"},"rows":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/class_seven_wall_message/0","jump":null,"original_index":0,"presentation":{"cg":"res://assets/cg/generated/archive_ch3_kairos_marks_v1.png"},"provenance":{"dialect":"field","group_position":3,"original_choice_index":-1,"original_index":0,"source_file":"data/chapter3_dialogue.json","source_hash":"bbd59b365314dbb0258eca53a4ca507894ad3d46af9dc601fdf783ceb280a6b9","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"speaker":"","text":"At dawn, Arrel stepped outside and stopped. Yesterday, the outer wall had been blank.","text_ko":"새벽, 밖으로 나온 아렐이 멈춰 섰다. 어제까지만 해도 바깥벽은 비어 있었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/class_seven_wall_message/1","jump":null,"original_index":1,"presentation":{},"provenance":{"dialect":"field","group_position":3,"original_choice_index":-1,"original_index":1,"source_file":"data/chapter3_dialogue.json","source_hash":"bbd59b365314dbb0258eca53a4ca507894ad3d46af9dc601fdf783ceb280a6b9","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"speaker":"","text":"Now a single line of Authority-standard script was embedded in the stone as if the wall itself had been edited.","text_ko":"이제는 관리국 표준 서체의 한 문장이, 벽 자체가 편집된 것처럼 돌 속에 박혀 있었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/class_seven_wall_message/2","jump":null,"original_index":2,"presentation":{"cg":"res://assets/cg/generated/chapter_expansion/ch03_class_seven_wall_v1.png"},"provenance":{"dialect":"field","group_position":3,"original_choice_index":-1,"original_index":2,"source_file":"data/chapter3_dialogue.json","source_hash":"bbd59b365314dbb0258eca53a4ca507894ad3d46af9dc601fdf783ceb280a6b9","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"speaker":"","text":"Subject demonstrates Class Seven combustion efficiency.","text_ko":"대상은 7급 연소 효율을 시현함."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/class_seven_wall_message/3","jump":null,"original_index":3,"presentation":{"portrait":"arrel_pain"},"provenance":{"dialect":"field","group_position":3,"original_choice_index":-1,"original_index":3,"source_file":"data/chapter3_dialogue.json","source_hash":"bbd59b365314dbb0258eca53a4ca507894ad3d46af9dc601fdf783ceb280a6b9","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":3,"text":{"speaker":"Arrel","text":"It wasn't here yesterday.","text_ko":"어제는 없었어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/class_seven_wall_message/4","jump":null,"original_index":4,"presentation":{},"provenance":{"dialect":"field","group_position":3,"original_choice_index":-1,"original_index":4,"source_file":"data/chapter3_dialogue.json","source_hash":"bbd59b365314dbb0258eca53a4ca507894ad3d46af9dc601fdf783ceb280a6b9","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":4,"text":{"speaker":"","text":"Elia read the sentence twice. Her jaw tightened. She did not ask who had written it.","text_ko":"엘리아는 문장을 두 번 읽었다. 턱에 힘이 들어갔다. 누가 썼는지는 묻지 않았다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/class_seven_wall_message/5","jump":null,"original_index":5,"presentation":{"portrait":"arrel_neutral"},"provenance":{"dialect":"field","group_position":3,"original_choice_index":-1,"original_index":5,"source_file":"data/chapter3_dialogue.json","source_hash":"bbd59b365314dbb0258eca53a4ca507894ad3d46af9dc601fdf783ceb280a6b9","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":5,"text":{"speaker":"Arrel","text":"We need to move.","text_ko":"움직여야 해."}}]},"dialect":"field","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"b27737ed67c44d1b4c5f679305e3dda3e184b7110d585730ecd1a008aefd91af","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/chapter3_dialogue.json","sha256_utf8_lf":"bbd59b365314dbb0258eca53a4ca507894ad3d46af9dc601fdf783ceb280a6b9"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
