{"content_kind":"narrative.vn","definition":{"id":"ch1_forest_walk","index_mapping_version":1,"metadata":{"chapter":1,"title":"Chapter 1, Through the Forest","title_ko":"1장, 숲을 지나"},"steps":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/0","jump":null,"original_index":0,"presentation":{"cg":"ch1_twisted_forest","fade_ms":1800},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":0,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"narrate":"Morning came thin and grey. The ash had stopped sometime in the dark, and the forest looked, almost, like a forest again.","narrate_ko":"희고 얇은 아침이 왔다. 밤사이 어느 순간 재는 그쳤고, 숲은 거의 숲처럼 보였다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/1","jump":null,"original_index":1,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":1,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"narrate":"Almost. The trees still leaned toward something he could not see. The path under his boots remembered other footsteps.","narrate_ko":"거의. 나무들은 아직 그가 볼 수 없는 무언가를 향해 기울어 있었고, 발밑의 길은 다른 발자국들을 기억하고 있었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/2","jump":null,"original_index":2,"presentation":{"portrait":"elia_neutral","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":2,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"speaker":"Elia","text":"Bureau patrols start at noon. We have until then.","text_ko":"관리국 순찰은 정오부터야. 그 전까지는 시간이 있어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/3","jump":null,"original_index":3,"presentation":{"portrait":"arrel_neutral","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":3,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":3,"text":{"speaker":"Arrel","text":"Long enough.","text_ko":"충분해."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/4","jump":null,"original_index":4,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":4,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":4,"text":{"narrate":"He looked at the clearing. Three things in his memory pulled at him before the fourth, the path forward.","narrate_ko":"그는 공터를 바라보았다. 앞으로 이어진 길보다 먼저, 기억 속 세 가지가 그를 잡아당겼다."}},{"action":{},"choices":[{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"set_flag":"fw_visited_stump"},"gate":{"requires_not_flag":"fw_visited_stump"},"id":"vn/ch1_forest_walk/5/choice/0","jump":7,"original_index":0,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":0,"original_index":5,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Examine the carved stump.","text_ko":"글자가 새겨진 그루터기를 살핀다."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"set_flag":"fw_visited_shrine"},"gate":{"requires_not_flag":"fw_visited_shrine"},"id":"vn/ch1_forest_walk/5/choice/1","jump":14,"original_index":1,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":1,"original_index":5,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Approach the small shrine in the bushes.","text_ko":"덤불 속 작은 사당에 다가간다."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"set_flag":"fw_talked_elia"},"gate":{"requires_not_flag":"fw_talked_elia"},"id":"vn/ch1_forest_walk/5/choice/2","jump":22,"original_index":2,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":2,"original_index":5,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Talk with Elia.","text_ko":"엘리아와 이야기한다."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{},"gate":{"requires_flag":"fw_visited_any"},"id":"vn/ch1_forest_walk/5/choice/3","jump":31,"original_index":3,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":3,"original_index":5,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Push deeper into the forest.","text_ko":"숲 깊은 곳으로 나아간다."}}],"choices_present":true,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/5","jump":null,"original_index":5,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":5,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":5,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/6","jump":null,"original_index":6,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":6,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":6,"text":{"narrate":"[ Filler, the choice block above always jumps past this. ]","narrate_ko":"[ 더미, 선택지는 항상 이 줄을 건너뜁니다. ]"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/7","jump":null,"original_index":7,"presentation":{"cg":"ch1_stump2","fade_ms":1000},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":7,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":7,"text":{"narrate":"A tree stump, old enough that its rings had turned to stone.","narrate_ko":"나이테가 돌처럼 굳어버릴 만큼 오래된 그루터기였다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/8","jump":null,"original_index":8,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":8,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":8,"text":{"narrate":"Someone had carved letters into it once. The rain had eaten most of them, but two remained: A. E.","narrate_ko":"누군가 오래전에 글자를 새겨두었다. 비가 대부분을 먹어치웠지만 두 글자는 남아 있었다. A. E."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/9","jump":null,"original_index":9,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":9,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":9,"text":{"narrate":"His hand moved toward the carving before he could stop it.","narrate_ko":"멈추기도 전에 그의 손이 새겨진 홈을 향해 움직였다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/10","jump":null,"original_index":10,"presentation":{"portrait":"elia_concern","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":10,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":10,"text":{"speaker":"Elia","text":"Arrel?","text_ko":"아렐?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/11","jump":null,"original_index":11,"presentation":{"portrait":"arrel_pensive","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":11,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":11,"text":{"speaker":"Arrel","text":"...Nothing. Just letters.","text_ko":"...아무것도 아니야. 그냥 글자야."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{"set_flag":"fw_visited_any"},"gate":{},"id":"vn/ch1_forest_walk/12","jump":null,"original_index":12,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":12,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":12,"text":{"narrate":"But his fingers traced the grooves one more time before he pulled away.","narrate_ko":"하지만 그는 손을 떼기 전, 한 번 더 손끝으로 홈을 더듬었다."}},{"action":{"action":"goto_scene","id":"ch1_forest_walk","start_index":5},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/13","jump":null,"original_index":13,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":13,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":13,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/14","jump":null,"original_index":14,"presentation":{"cg":"ch1_ash_forest","fade_ms":1000},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":14,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":14,"text":{"narrate":"A small shrine, half-swallowed by bushes. Smooth stones stacked into a cairn no taller than his knee.","narrate_ko":"덤불에 반쯤 삼켜진 작은 사당. 매끈한 돌들이 그의 무릎보다 낮은 돌무더기로 쌓여 있었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/15","jump":null,"original_index":15,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":15,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":15,"text":{"narrate":"Wax had pooled at the base, old, candle after candle, year after year. Someone had been keeping vigil here.","narrate_ko":"밑동에는 촛농이 고여 있었다. 오래된 촛농, 해마다 더해진 촛농. 누군가 이곳을 계속 지켜온 것이다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/16","jump":null,"original_index":16,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":16,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":16,"text":{"narrate":"On top of the cairn, a single brass token. A name engraved, worn nearly smooth. He could not read it.","narrate_ko":"돌무더기 위에는 황동 표식 하나가 놓여 있었다. 새겨진 이름은 닳아 거의 매끈해졌고, 그는 읽을 수 없었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/17","jump":null,"original_index":17,"presentation":{"portrait":"elia_sad","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":17,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":17,"text":{"speaker":"Elia","text":"Burners come here. The ones who don't have a body to bury.","text_ko":"연소자들이 여기 와. 묻어줄 몸조차 없는 사람들."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/18","jump":null,"original_index":18,"presentation":{"portrait":"elia_calm","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":18,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":18,"text":{"speaker":"Elia","text":"They leave a name. Sometimes their own.","text_ko":"이름을 남겨. 가끔은 자기 이름을."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/19","jump":null,"original_index":19,"presentation":{"portrait":"arrel_cold","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":19,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":19,"text":{"speaker":"Arrel","text":"...Sometimes someone else's.","text_ko":"...가끔은 다른 사람의 이름을."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{"set_flag":"fw_visited_any"},"gate":{},"id":"vn/ch1_forest_walk/20","jump":null,"original_index":20,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":20,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":20,"text":{"narrate":"He did not leave a token. He did not have one to spare.","narrate_ko":"그는 표식을 남기지 않았다. 남길 만큼 가진 것이 없었다."}},{"action":{"action":"goto_scene","id":"ch1_forest_walk","start_index":5},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/21","jump":null,"original_index":21,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":21,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":21,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/22","jump":null,"original_index":22,"presentation":{"cg":"res://assets/cg/generated/story_ch1_elia_reunion.png","fade_ms":1000},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":22,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":22,"text":{"narrate":"Elia waited where the path forked, hands loose at her sides, watching him in that careful way she had.","narrate_ko":"엘리아는 갈림길에서 기다리고 있었다. 양손을 느슨하게 내린 채, 늘 그렇듯 조심스럽게 그를 바라보며."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/23","jump":null,"original_index":23,"presentation":{"portrait":"elia_concern","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":23,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":23,"text":{"speaker":"Elia","text":"How are you holding up?","text_ko":"버틸 만해?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/24","jump":null,"original_index":24,"presentation":{"portrait":"arrel_neutral","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":24,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":24,"text":{"speaker":"Arrel","text":"Standing.","text_ko":"서 있잖아."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/25","jump":null,"original_index":25,"presentation":{"portrait":"elia_sad","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":25,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":25,"text":{"speaker":"Elia","text":"That's not what I asked.","text_ko":"내가 물은 건 그게 아니야."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/26","jump":null,"original_index":26,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":26,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":26,"text":{"narrate":"He didn't answer. She did not push.","narrate_ko":"그는 대답하지 않았다. 그녀도 더 묻지 않았다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/27","jump":null,"original_index":27,"presentation":{"distorted_portrait":"elia_sad","portrait":"elia_hopeful","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":27,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":27,"text":{"distort_if_burned":"daily_campfire_song","distorted_text":"Whatever happens out there, try not to burn the rest of yourself.","distorted_text_ko":"저 밖에서 무슨 일이 있어도, 남은 너 자신까지 태우지는 마.","speaker":"Elia","text":"Whatever happens out there, you don't have to burn anything else today.","text_ko":"저 밖에서 무슨 일이 있어도, 오늘은 더 태우지 않아도 돼."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/28","jump":null,"original_index":28,"presentation":{"portrait":"arrel_pensive","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":28,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":28,"text":{"speaker":"Arrel","text":"...I'll try.","text_ko":"...노력해볼게."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{"set_flag":"fw_visited_any"},"gate":{},"id":"vn/ch1_forest_walk/29","jump":null,"original_index":29,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":29,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":29,"text":{"narrate":"She nodded, once, and looked away.","narrate_ko":"그녀는 한 번 고개를 끄덕이고 시선을 돌렸다."}},{"action":{"action":"goto_scene","id":"ch1_forest_walk","start_index":5},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/30","jump":null,"original_index":30,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":30,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":30,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/31","jump":null,"original_index":31,"presentation":{"cg":"res://assets/cg/generated/story_ch1_void_beast_emergence.png","fade_ms":1600},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":31,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":31,"text":{"narrate":"The path narrowed. The trees pressed closer.","narrate_ko":"길은 좁아졌다. 나무들이 더 가까이 밀려왔다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/32","jump":null,"original_index":32,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":32,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":32,"text":{"narrate":"Something had been here. The ground was wrong, patches of moss bleached white, bark stripped in long parallel grooves.","narrate_ko":"무언가가 이곳에 있었다. 땅이 이상했다. 이끼는 군데군데 하얗게 바랬고, 나무껍질은 길고 평행한 홈으로 벗겨져 있었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/33","jump":null,"original_index":33,"presentation":{"portrait":"elia_concern","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":33,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":33,"text":{"speaker":"Elia","text":"Arrel.","text_ko":"아렐."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/34","jump":null,"original_index":34,"presentation":{"portrait":"arrel_determined","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":34,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":34,"text":{"speaker":"Arrel","text":"I see it.","text_ko":"보여."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/35","jump":null,"original_index":35,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":35,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":35,"text":{"narrate":"Ahead, where the canopy opened, something exhaled.","narrate_ko":"앞쪽, 나뭇잎 사이가 열린 곳에서 무언가가 숨을 내쉬었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/36","jump":null,"original_index":36,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":36,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":36,"text":{"narrate":"Not breath. Something that wanted to be breath but had forgotten how.","narrate_ko":"숨은 아니었다. 숨이고 싶었지만 방법을 잊어버린 무언가였다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/37","jump":null,"original_index":37,"presentation":{"portrait":"elia_determined","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":37,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":37,"text":{"speaker":"Elia","text":"It's between us and the road. We can't go around.","text_ko":"저게 우리와 길 사이에 있어. 돌아갈 수 없어."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/38","jump":null,"original_index":38,"presentation":{"portrait":"arrel_determined","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":38,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":38,"text":{"speaker":"Arrel","text":"I know.","text_ko":"알아."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/39","jump":null,"original_index":39,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":39,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":39,"text":{"narrate":"He drew his sword. The grip remembered his hand, even when he did not always remember the grip.","narrate_ko":"그는 검을 뽑았다. 그가 손잡이를 늘 기억하는 것은 아니었지만, 손잡이는 그의 손을 기억하고 있었다."}},{"action":{"action":"goto_scene","id":"ch1_void_beast"},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch1_forest_walk/40","jump":null,"original_index":40,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":40,"source_file":"data/vn_scenes/ch1_forest_walk.json","source_hash":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":40,"text":{}}]},"dialect":"vn","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"5012ba928ac57807b17e612455270d69b474379d275d738b9da002a4c9339310","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/vn_scenes/ch1_forest_walk.json","sha256_utf8_lf":"7d282cc6aaaececd88a67fa51d659388b7a8975e54da608e9ef9a90d619e41c6"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
