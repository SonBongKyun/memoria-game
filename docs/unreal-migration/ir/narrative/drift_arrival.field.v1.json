{"content_kind":"narrative.field","definition":{"id":"drift_arrival","index_mapping_version":1,"metadata":{"chapter":4,"title":"Drift","title_ko":"표류"},"rows":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/drift_arrival/0","jump":null,"original_index":0,"presentation":{"cg":"res://assets/cg/generated/chapter_splash_drift_shelter.png"},"provenance":{"dialect":"field","group_position":0,"original_choice_index":-1,"original_index":0,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"speaker":"","text":"The trail markers had words on them. Elia read each one aloud as they passed.","text_ko":"이정표에는 글자가 적혀 있었다. 엘리아는 지나칠 때마다 하나씩 소리 내어 읽었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/drift_arrival/1","jump":null,"original_index":1,"presentation":{"portrait":"elia_neutral"},"provenance":{"dialect":"field","group_position":0,"original_choice_index":-1,"original_index":1,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"speaker":"Elia","text":"South toward the Rim border. Fourteen kilometers to the next waypoint.","text_ko":"남쪽은 림 경계. 다음 경유지까지 14킬로미터."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/drift_arrival/2","jump":null,"original_index":2,"presentation":{},"provenance":{"dialect":"field","group_position":0,"original_choice_index":-1,"original_index":2,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"speaker":"","text":"Arrel saw every letter, but they refused to connect. The part where shapes became a word was broken.","text_ko":"아렐은 모든 글자를 보았지만 서로 이어지지 않았다. 형상이 단어가 되는 부분이 망가져 있었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/drift_arrival/3","jump":null,"original_index":3,"presentation":{},"provenance":{"dialect":"field","group_position":0,"original_choice_index":-1,"original_index":3,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":3,"text":{"speaker":"","text":"A recent Ash Rain had left a fine grey film over the Belt's edge. The rain itself was gone; grit remained on his tongue.","text_ko":"최근 지나간 재비가 벨트 가장자리에 얇은 회색 막을 남겼다. 비는 이미 그쳤고, 혀 위에는 모래만 남았다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/drift_arrival/4","jump":null,"original_index":4,"presentation":{"portrait":"elia_concern"},"provenance":{"dialect":"field","group_position":0,"original_choice_index":-1,"original_index":4,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":4,"text":{"speaker":"Elia","text":"Arrel. What does that marker say?","text_ko":"아렐. 저 이정표에 뭐라고 쓰여 있어?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/drift_arrival/5","jump":null,"original_index":5,"presentation":{"portrait":"arrel_pain"},"provenance":{"dialect":"field","group_position":0,"original_choice_index":-1,"original_index":5,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":5,"text":{"speaker":"Arrel","text":"The letters aren't holding.","text_ko":"글자가 붙어 있지 않아."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/drift_arrival/6","jump":null,"original_index":6,"presentation":{"portrait":"elia_concern"},"provenance":{"dialect":"field","group_position":0,"original_choice_index":-1,"original_index":6,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":6,"text":{"speaker":"Elia","text":"We're stopping.","text_ko":"멈출 거야."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"gate_then_effects","effects":{},"gate":{},"id":"field/drift_arrival/7","jump":null,"original_index":7,"presentation":{},"provenance":{"dialect":"field","group_position":0,"original_choice_index":-1,"original_index":7,"source_file":"data/chapter4_dialogue.json","source_hash":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":7,"text":{"speaker":"","text":"She led him to a hollow screened by the collapsed wall of an old shepherd's shelter.","text_ko":"그녀는 무너진 옛 목동 쉼터의 벽이 가려 주는 바위 웅덩이로 그를 이끌었다."}}]},"dialect":"field","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"6c3e3f141ee33fc0fbe8919899978decd782d064eeffca5b5ebe6659a4fa6aa4","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/chapter4_dialogue.json","sha256_utf8_lf":"355cead07d937895d476c3f30ee8ba2f22d58abaf232bb17c4c4e4e1f3edab53"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
