{"content_kind":"narrative.vn","definition":{"id":"ch5_classifier","index_mapping_version":1,"metadata":{"chapter":5,"title":"Chapter 5, The Classifier","title_ko":"5장, 분류자"},"steps":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/0","jump":null,"original_index":0,"presentation":{"cg":"res://assets/cg/generated/cinematic_kairos_authority_edit.png","fade_ms":1800},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":0,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"narrate":"Two days after the Void Beast died, a traveling clerk entered the clearing alone.","narrate_ko":"공허수가 죽은 지 이틀 뒤, 행상 서기 차림의 남자가 홀로 공터에 들어섰다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/1","jump":null,"original_index":1,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":1,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"narrate":"His coat was drab, his face forgettable. Only the black Authority notebook in his hand refused to disappear into the ash.","narrate_ko":"외투는 칙칙했고 얼굴은 기억에 남지 않았다. 손에 든 검은 관리국 수첩만이 잿빛 풍경에 묻히기를 거부했다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/2","jump":null,"original_index":2,"presentation":{"portrait":"kairos_neutral","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":2,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"speaker":"Kairos","text":"Combustion residue. Two days old.","text_ko":"연소 잔재. 이틀 전의 것."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/3","jump":null,"original_index":3,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":3,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":3,"text":{"narrate":"Kairós set a brass instrument against the scar in the ground. Its needle climbed past the calibrated scale.","narrate_ko":"카이로스는 땅의 상흔에 황동 측정기를 댔다. 바늘은 보정된 눈금을 넘어 치솟았다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/4","jump":null,"original_index":4,"presentation":{"portrait":"kairos_cold","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":4,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":4,"text":{"speaker":"Kairos","text":"Yield exceeds projection by a factor of ten.","text_ko":"산출량이 예측치의 열 배를 넘는다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/5","jump":null,"original_index":5,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":5,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":5,"text":{"narrate":"He touched a blade of white grass with the bone pen. Green returned for three breaths, then drained away.","narrate_ko":"그가 뼈로 만든 펜을 흰 풀잎에 대자 세 번의 숨 동안 초록이 돌아왔다가 다시 빠져나갔다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/6","jump":null,"original_index":6,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":6,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":6,"text":{"narrate":"A burned splinter became an unburned cylinder. The correction was small, exact, and temporary.","narrate_ko":"탄 나뭇조각은 타지 않은 원통으로 바뀌었다. 수정은 작고 정확했으며 일시적이었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/7","jump":null,"original_index":7,"presentation":{"portrait":"kairos_cold","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":7,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":7,"text":{"speaker":"Kairos","text":"Class Seven. Confirmed.","text_ko":"7등급. 확인."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/8","jump":null,"original_index":8,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":8,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":8,"text":{"narrate":"The black notebook received the official measurements. The red notebook received what the Authority would not.","narrate_ko":"검은 수첩에는 공식 측정값이 적혔다. 붉은 수첩에는 관리국에 보내지 않을 내용이 적혔다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/9","jump":null,"original_index":9,"presentation":{"portrait":"kairos_neutral","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":9,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":9,"text":{"speaker":"Kairos","text":"Withhold classification. Preserve the specimen.","text_ko":"분류 결과는 보류한다. 표본을 보존한다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/10","jump":null,"original_index":10,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":10,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":10,"text":{"narrate":"The decision violated Directive Four. Kairós wrote it without hesitation.","narrate_ko":"그 결정은 지침 4호를 위반했다. 카이로스는 망설임 없이 적었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/11","jump":null,"original_index":11,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":11,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":11,"text":{"narrate":"A coded report from Verdan waited beneath the field measurements: a buyer had traded the memory of a first sword for the route to BL-07.","narrate_ko":"현장 측정값 아래에는 베르단에서 온 암호 보고가 기다리고 있었다. 한 구매자가 첫 검의 기억을 BL-07 경로와 맞바꾸었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{"requires_flag":"ch5_malet_report_identified_arrel"},"id":"vn/ch5_classifier/12","jump":null,"original_index":12,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":12,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":12,"text":{"narrate":"The public line called him nameless. Malet's private source mark still resolved the requester: Arrel.","narrate_ko":"공식 문구는 그를 이름 없는 구매자라 불렀다. 하지만 말렛의 비공개 출처 표식은 요청자를 가리켰다. 아렐."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{"requires_flag":"ch5_malet_report_identified_arrel"},"id":"vn/ch5_classifier/13","jump":null,"original_index":13,"presentation":{"portrait":"kairos_cold","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":13,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":13,"text":{"speaker":"Kairos","text":"The buyer and the subject are one.","text_ko":"구매자와 대상은 동일 인물이다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{"requires_flag":"ch5_malet_report_requester_unknown"},"id":"vn/ch5_classifier/14","jump":null,"original_index":14,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":14,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":14,"text":{"narrate":"The request remained in Malet's report. The requester did not. Its source field ended in a clean omission.","narrate_ko":"말렛의 보고에는 요청이 남아 있었다. 요청자는 남아 있지 않았다. 출처란은 깨끗한 누락으로 끝났다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{"requires_flag":"ch5_malet_report_requester_unknown"},"id":"vn/ch5_classifier/15","jump":null,"original_index":15,"presentation":{"portrait":"kairos_neutral","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":15,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":15,"text":{"speaker":"Kairos","text":"The market retained the event, not the name.","text_ko":"시장은 사건은 보존했지만 이름은 보존하지 못했다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/16","jump":null,"original_index":16,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":16,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":16,"text":{"narrate":"A woman occupied half a sentence in the same report. Malet had circled the phrase twice: she made burned memories leave a residue.","narrate_ko":"같은 보고에서 한 여자는 반 문장만을 차지했다. 말렛은 그 구절에 두 번 동그라미를 쳤다. 그녀는 탄 기억이 잔재를 남기게 했다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/17","jump":null,"original_index":17,"presentation":{"portrait":"kairos_cold","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":17,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":17,"text":{"speaker":"Kairos","text":"An anchor. More interesting than the route.","text_ko":"앵커인가. 경로보다 흥미롭군."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/18","jump":null,"original_index":18,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":18,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":18,"text":{"narrate":"Arrel and Elia were already days east. The Classifier did not follow. He revised the distance between them into a schedule.","narrate_ko":"아렐과 엘리아는 이미 며칠 거리만큼 동쪽에 있었다. 분류자는 뒤쫓지 않았다. 그는 그 거리를 일정표로 고쳐 적었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/19","jump":null,"original_index":19,"presentation":{"portrait":"kairos_neutral","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":19,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":19,"text":{"speaker":"Kairos","text":"Observation concluded. Contact initiated. Patient approach.","text_ko":"관찰 종료. 접촉 개시. 신중히 접근한다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch5_classifier/20","jump":null,"original_index":20,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":20,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":20,"text":{"narrate":"He closed the red notebook. Behind him, the corrected grass turned white again.","narrate_ko":"그가 붉은 수첩을 덮었다. 등 뒤에서 수정되었던 풀잎이 다시 하얗게 변했다."}},{"action":{"action":"goto_map","path":"res://scenes/maps/drift_shelter.tscn"},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{"autosave_chapter_transition":true,"complete_chapter":5,"set_flag":"canon_ch6_seam_ready"},"gate":{},"id":"vn/ch5_classifier/21","jump":null,"original_index":21,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":21,"source_file":"data/vn_scenes/ch5_classifier.json","source_hash":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":21,"text":{}}]},"dialect":"vn","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"f01516b2decdc5edac95c3855a99f028f59594f61030caeacb25ab6060cabe8b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/vn_scenes/ch5_classifier.json","sha256_utf8_lf":"8349c7b6a890266c112c7e8410a13f3eaabd4b4060cebf34905f630726e0a0a0"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
