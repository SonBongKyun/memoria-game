{"content_kind":"narrative.field","definition":{"id":"ch2_market_arrival","index_mapping_version":1,"metadata":{"bgm":"res://assets/audio/bgm/ch2_verdan.mp3","chapter":2,"title":"Chapter 2, The Belt","title_ko":"제2장, 벨트"},"steps":[{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/0","jump":null,"original_index":0,"presentation":{"cg":"res://assets/cg/generated/story_ch2_verdan_gate.png","fade_ms":2000},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":0,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":0,"text":{"narrate":"Verdan Market, the Belt's largest trading hub, and the Bureau's most tolerated black eye.","narrate_ko":"베르단 시장(베르단 Market), 벨트의 가장 큰 거래 허브이자 관리국에서 가장 용인되는 검은 눈입니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/1","jump":null,"original_index":1,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":1,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":1,"text":{"narrate":"It sprawled across three old canyons, stitched together with rope-bridges and smoke and the low hum of too many voices at once.","narrate_ko":"그것은 세 개의 오래된 협곡을 가로질러 펼쳐져 있었고, 밧줄 다리와 연기, 동시에 너무 많은 목소리의 낮은 웅웅거림이 얽혀 있었습니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/2","jump":null,"original_index":2,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":2,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":2,"text":{"narrate":"Somewhere down there, Malet kept a desk. And Malet, if rumor held, kept debts, including whatever was owed to the name Arrel no longer wanted to say aloud.","narrate_ko":"저 아래 어딘가에 말렛는 책상을 보관했습니다. 그리고 말렛는 소문이 사실이라면 아렐이라는 이름에 빚진 모든 것을 포함하여 더 이상 큰 소리로 말하고 싶지 않은 빚을 유지했습니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/3","jump":null,"original_index":3,"presentation":{"cg":"res://assets/cg/generated/story_ch2_verdan_gate.png","fade_ms":1400,"portrait":"elia_calm","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":3,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":3,"text":{"speaker":"Elia","text":"Stay close. This place eats travelers.","text_ko":"가까이 있어라. 이곳은 여행자를 잡아먹는다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/4","jump":null,"original_index":4,"presentation":{"portrait":"arrel_neutral","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":4,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":4,"text":{"speaker":"Arrel","text":"I'll stay close. You keep your hood up.","text_ko":"나는 가까이 있을 것이다. 당신은 후드를 유지합니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/5","jump":null,"original_index":5,"presentation":{"portrait":"elia_hopeful","side":"right"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":5,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":5,"text":{"speaker":"Elia","text":"Worried about me?","text_ko":"나에 대해 걱정 되니?"}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/6","jump":null,"original_index":6,"presentation":{"portrait":"arrel_pensive","side":"left"},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":6,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":6,"text":{"speaker":"Arrel","text":"Worried about what someone might recognize.","text_ko":"누군가가 무엇을 알아볼지 걱정됩니다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/7","jump":null,"original_index":7,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":7,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":7,"text":{"narrate":"Below them, the market opened its mouth.","narrate_ko":"그 아래에는 시장이 입을 열었다."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/8","jump":null,"original_index":8,"presentation":{"cg":"res://assets/cg/generated/story_ch2_verdan_gate.png","fade_ms":1200},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":8,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":8,"text":{"narrate":"A guard stopped them at the southern stairs. Bureau insignia. Too alert for a Belt posting.","narrate_ko":"경비원이 남쪽 계단에서 그들을 막았습니다. 국 휘장. 벨트 포스팅에 너무 주의하세요."}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/9","jump":null,"original_index":9,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":9,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":9,"text":{"speaker":"Guard","text":"Names. Purpose. Papers if you have them.","text_ko":"이름. 목적. 서류가 있다면."}},{"action":{},"choices":[{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"set_flag":"guard_lied_to"},"gate":{},"id":"vn/ch2_market_arrival/10/choice/0","jump":null,"original_index":0,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":0,"original_index":10,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Tell him we're hunters tracking rogue Husks.","text_ko":"우리는 불량 허스크를 추적하는 사냥꾼이라고 전해 주세요."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"cost_memory":"daily_market_food","set_flag":"guard_bribed"},"gate":{},"id":"vn/ch2_market_arrival/10/choice/1","jump":null,"original_index":1,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":1,"original_index":10,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Surface a memory of a bribe. Pay him off with what he wants to hear.","text_ko":"뇌물을 받은 기억을 떠올려 보세요. 그가 듣고 싶어하는 말로 그에게 보답하십시오."}},{"action":{},"effect_phase":"cost_then_flags_burn_rewards_blocking","effects":{"set_flag":"guard_pushed"},"gate":{"requires_memory_intact":"identity_first_sword"},"id":"vn/ch2_market_arrival/10/choice/2","jump":null,"original_index":2,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":2,"original_index":10,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"text":{"text":"Push past him.","text_ko":"그를 지나쳐라."}}],"choices_present":true,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/10","jump":null,"original_index":10,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":10,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":10,"text":{}},{"action":{},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{},"gate":{},"id":"vn/ch2_market_arrival/11","jump":null,"original_index":11,"presentation":{"cg":"res://assets/cg/generated/story_ch2_memory_market.png","fade_ms":1000},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":11,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":11,"text":{"narrate":"Either way, the market swallowed them whole.","narrate_ko":"어느 쪽이든 시장은 그들을 통째로 삼켰다."}},{"action":{"action":"goto_map","path":"res://scenes/maps/verdan_market.tscn"},"choices":[],"choices_present":false,"effect_phase":"effects_then_gate_then_rewards","effects":{"set_flag":"ch2_arrival_vn_seen"},"gate":{},"id":"vn/ch2_market_arrival/12","jump":null,"original_index":12,"presentation":{},"provenance":{"dialect":"vn","group_position":0,"original_choice_index":-1,"original_index":12,"source_file":"data/vn_scenes/ch2_market_arrival.json","source_hash":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949"},"storage_index":12,"text":{}}]},"dialect":"vn","extractor_version":"memoria-narrative/1","schema_version":1,"semantic_sha256":"46fb5e5c1d747ad99fbc6aff4ad708c4b6320fd10af6465e95f40b28222ac51e","source_revision":"4f772fafb1c7c6da68f56f44d60a7c7fed7f3949","sources":[{"path":"data/vn_scenes/ch2_market_arrival.json","sha256_utf8_lf":"970ae54c68e1d5b4337bd27267c047ad3c8a5113ee2cd7e2a23324333ebc980b"},{"path":"scripts/systems/dialogue_manager.gd","sha256_utf8_lf":"b6163afcadbee0ad9e799d17caa57e16b949a3bc2a3dbd418391aed929ccce4a"},{"path":"scripts/systems/scene_flow.gd","sha256_utf8_lf":"733bdd697ceaa1a82976164be5455ac792f94b5ec2a6c02716a5492c1ae4930d"},{"path":"scripts/ui/vn_scene.gd","sha256_utf8_lf":"8da6f03fa6ff1e9695f3fcb985a79eacf96d3b74f5f49e2489c831d9eccc26ce"},{"path":"scenes/main/vn_host.gd","sha256_utf8_lf":"a5a6c2295916b494cff559760616d9734d05652e20f7e531f930984a71246275"},{"path":"scenes/maps/verdan_market.gd","sha256_utf8_lf":"25ff88bad40722ccecc1f02b270201b6b0771031eec511592afbcab88ad94ce3"},{"path":"scripts/systems/memory_manager.gd","sha256_utf8_lf":"5551c4fe5541e5201541a4dcee835ae4ec8fc7404167a4fc81e547e3b0520938"},{"path":"scripts/utils/journey_oath.gd","sha256_utf8_lf":"39610117fa7a7b357960a931b024a28b1a27068f5da5d3602d67829b7a3d2635"},{"path":"scripts/core/game_manager.gd","sha256_utf8_lf":"302846dfed4304f009b39a728812ac91484cfe6b858e235e661e84fa7fb9e6d1"}]}
