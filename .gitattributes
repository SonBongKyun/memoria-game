# New Unreal binary packages only. No history rewrite or Godot renormalization.
Unreal/**/*.uasset filter=lfs diff=lfs merge=lfs -text
Unreal/**/*.umap filter=lfs diff=lfs merge=lfs -text

# Preserve the exact bytes attested by the offline Godot oracle on checkout.
# Inputs were written by Python on Windows; outputs were written by Godot.
docs/unreal-migration/fixtures/player_memory_inputs.json text eol=crlf
docs/unreal-migration/fixtures/player_memory_expected.json text eol=lf

# Canonical source-derived Phase 1C artifacts remain UTF-8/LF on Windows.
docs/unreal-migration/ir/*.json text eol=lf
docs/unreal-migration/ir/narrative/** text eol=lf
docs/unreal-migration/fixtures/narrative/** text eol=lf
docs/unreal-migration/fixtures/campaign/** text eol=lf
docs/unreal-migration/fixtures/malet/** text eol=lf

docs/unreal-migration/fixtures/malet_refusal/** text eol=lf

docs/unreal-migration/fixtures/malet_deal/** text eol=lf

docs/unreal-migration/fixtures/malet_reward/** text eol=lf

docs/unreal-migration/fixtures/malet_first_effect/** text eol=lf
