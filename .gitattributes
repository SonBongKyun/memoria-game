# Apply Git LFS only to dedicated future source/master asset paths.
# Existing runtime assets/history are deliberately not reclassified here.
# See docs/ASSET_STORAGE.md before migrating old media.
assets/source/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/source/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/source/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/source/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/source/**/*.psd filter=lfs diff=lfs merge=lfs -text
assets/source/**/*.blend filter=lfs diff=lfs merge=lfs -text
assets/audio/master/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/audio/master/**/*.flac filter=lfs diff=lfs merge=lfs -text
assets/video/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
assets/video/**/*.webm filter=lfs diff=lfs merge=lfs -text
